pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Descarga el código desde el SCM configurado
                checkout scm 
            }
        }
        stage('Restore') {
            steps {
                // 'bat' es el comando correcto para Jenkins en Windows
                bat 'dotnet restore projectCalculadora.sln'
            }
        }
        stage('Build') {
            steps {
                bat 'dotnet build projectCalculadora.sln --configuration Release --no-restore'
            }
        }
        stage('Test') {
            steps {
                bat 'dotnet test calculadoraApp.Tests/calculadoraApp.Tests.csproj --configuration Release --no-build'
            }
        }
        stage('Publish') {
            steps {
                bat 'dotnet publish calculadoraApp/calculadoraApp.csproj -c Release -o publish'
            }
        }
    }
    post {
        success {
            // Guarda los archivos generados para que puedas descargarlos desde la interfaz de Jenkins
            archiveArtifacts artifacts: 'publish/**', fingerprint: true
        }
    }
}